+                  Functions functions, bool enabled) {
+    device_ = device;
+    properties_ = properties;
+    functions_ = functions;
+    if (enabled) {
+      VkPipelineCacheCreateInfo info{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+      if (functions_.create(device_, &info, nullptr, &cache_) != VK_SUCCESS)
+        cache_ = VK_NULL_HANDLE;
+    }
+  }
+
+  bool Compatible(const std::vector<uint8_t>& bytes) const {
+    if (bytes.size() < sizeof(VkPipelineCacheHeaderVersionOne)) return false;
+    VkPipelineCacheHeaderVersionOne header;
+    std::memcpy(&header, bytes.data(), sizeof(header));
+    return header.headerSize >= sizeof(header) && header.headerSize <= bytes.size() &&
+           header.headerVersion == VK_PIPELINE_CACHE_HEADER_VERSION_ONE &&
+           header.vendorID == properties_.vendorID && header.deviceID == properties_.deviceID &&
+           !std::memcmp(header.pipelineCacheUUID, properties_.pipelineCacheUUID, VK_UUID_SIZE);
+  }
+
+  bool Load(const std::filesystem::path& path) {
+    std::ifstream input(path, std::ios::binary | std::ios::ate);
+    if (!input) return false;
+    const auto size = input.tellg();
+    if (size < std::streamoff(sizeof(FileHeader) + sizeof(VkPipelineCacheHeaderVersionOne)) ||
+        size > std::streamoff(sizeof(FileHeader) + kMaxBytes)) return false;
+    std::vector<uint8_t> bytes(static_cast<size_t>(size) - sizeof(FileHeader));
+    input.seekg(0);
+    FileHeader file_header;
+    if (!input.read(reinterpret_cast<char*>(&file_header), sizeof(file_header)) ||
+        file_header.magic != kFileMagic || file_header.size != bytes.size() ||
+        !input.read(reinterpret_cast<char*>(bytes.data()), std::streamsize(bytes.size())) ||
+        file_header.checksum != XXH3_64bits(bytes.data(), bytes.size()) ||
+        !Compatible(bytes)) return false;
+    std::unique_lock<std::shared_mutex> lock(mutex_);
+    if (cache_ == VK_NULL_HANDLE) return false;
+    VkPipelineCacheCreateInfo info{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+    info.initialDataSize = bytes.size();
+    info.pInitialData = bytes.data();
+    VkPipelineCache loaded = VK_NULL_HANDLE;
+    if (functions_.create(device_, &info, nullptr, &loaded) != VK_SUCCESS) return false;
+    const VkResult result = functions_.merge(device_, cache_, 1, &loaded);
+    functions_.destroy(device_, loaded, nullptr);
+    return result == VK_SUCCESS;
+  }
+
+  VkResult CreateGraphics(uint32_t count, const VkGraphicsPipelineCreateInfo* infos,
+                          const VkAllocationCallbacks* allocator, VkPipeline* pipelines) {
+    std::shared_lock<std::shared_mutex> lock(mutex_);
+    const VkResult result = functions_.graphics(device_, cache_, count, infos, allocator, pipelines);
+    if (result == VK_SUCCESS) ++generation_;
+    return result;
+  }
+
+  bool Save(const std::filesystem::path& path) {
+    if (path.empty()) return false;
+    std::vector<uint8_t> bytes;
+    uint64_t generation;
+    {
+      std::unique_lock<std::shared_mutex> lock(mutex_);
+      if (cache_ == VK_NULL_HANDLE || generation_ == saved_generation_) return false;
+      size_t size = 0;
+      if (functions_.data(device_, cache_, &size, nullptr) != VK_SUCCESS ||
+          size < sizeof(VkPipelineCacheHeaderVersionOne) || size > kMaxBytes) return false;
+      bytes.resize(size);
+      if (functions_.data(device_, cache_, &size, bytes.data()) != VK_SUCCESS ||
+          size > bytes.size()) return false;
+      bytes.resize(size);
+      generation = generation_.load();
+    }
+    if (!Compatible(bytes)) return false;
+    std::error_code error;
+    std::filesystem::create_directories(path.parent_path(), error);
+    if (error) return false;
+    auto temporary = path;
+    temporary += ".tmp";
+    {
+      std::ofstream output(temporary, std::ios::binary | std::ios::trunc);
+      const FileHeader file_header{kFileMagic, bytes.size(), XXH3_64bits(bytes.data(), bytes.size())};
+      if (!output.write(reinterpret_cast<const char*>(&file_header), sizeof(file_header)) ||
+          !output.write(reinterpret_cast<const char*>(bytes.data()), std::streamsize(bytes.size())))
+        return false;
+      output.close();
+      if (!output) return false;
+    }
+#if defined(_WIN32)
+    if (!MoveFileExW(temporary.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING)) return false;
+#else
+    std::filesystem::rename(temporary, path, error);
+    if (error) return false;
+#endif
+    std::unique_lock<std::shared_mutex> lock(mutex_);
+    saved_generation_ = generation;
+    return true;
+  }
+
+  void Shutdown() {
+    std::unique_lock<std::shared_mutex> lock(mutex_);
+    if (cache_ != VK_NULL_HANDLE) functions_.destroy(device_, cache_, nullptr);
+    cache_ = VK_NULL_HANDLE;
+    generation_ = 0;
+    saved_generation_ = 0;
+  }
+
+ private:
+  struct FileHeader { uint64_t magic, size, checksum; };
+  static constexpr uint64_t kFileMagic = 0x3156435244584552ull;
+  static constexpr size_t kMaxBytes = 64 * 1024 * 1024;
+  VkDevice device_ = VK_NULL_HANDLE;
+  VkPipelineCache cache_ = VK_NULL_HANDLE;
+  VkPhysicalDeviceProperties properties_{};
+  Functions functions_{};
+  std::shared_mutex mutex_;
+  std::atomic<uint64_t> generation_{0};
+  uint64_t saved_generation_ = 0;
+};
+
+}  // namespace rex::graphics::vulkan
diff --git a/include/rex/graphics/vulkan/shared_write_ranges.h b/include/rex/graphics/vulkan/shared_write_ranges.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/shared_write_ranges.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+
+namespace rex::graphics::vulkan {
+
+// Accumulate every unsynchronized write, including gaps conservatively. Only
+// valid for write-only operations; guest draws may also read arbitrary ranges.
+inline bool AccumulateDisjointSharedWrites(std::pair<uint32_t, uint32_t>& pending,
+                                          std::pair<uint32_t, uint32_t> next) {
+  const uint64_t pending_end = uint64_t(pending.first) + pending.second;
+  const uint64_t next_end = uint64_t(next.first) + next.second;
+  if (!pending.second || !next.second || pending_end > UINT32_MAX || next_end > UINT32_MAX ||
+      (pending_end > next.first && next_end > pending.first)) return false;
+  const uint32_t start = std::min(pending.first, next.first);
+  pending = {start, uint32_t(std::max(pending_end, next_end) - start)};
+  return true;
+}
+
+}  // namespace rex::graphics::vulkan
