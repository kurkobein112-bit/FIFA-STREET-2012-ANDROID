+
+void DeferredCommandBuffer::EndHoistedSharedMemoryUpload() {
+  assert_true(IsRecordingHoistedSharedUpload());
+  assert_true(render_pass_start_ != SIZE_MAX);
+  const size_t size = command_stream_.size() - shared_upload_start_;
+  // Keep both ordering barriers and every copy together, outside the pass.
+  std::rotate(command_stream_.begin() + render_pass_start_,
+              command_stream_.begin() + shared_upload_start_, command_stream_.end());
+  render_pass_start_ += size;
+  shared_upload_start_ = SIZE_MAX;
