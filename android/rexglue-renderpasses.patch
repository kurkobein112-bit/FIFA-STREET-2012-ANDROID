+
+bool DeferredCommandBuffer::TryHoistSharedMemoryReadBarrier(
+    VkBuffer shared_buffer, VkPipelineStageFlags src_stage_mask,
+    VkPipelineStageFlags dst_stage_mask,
+    const std::vector<VkBufferMemoryBarrier>& barriers) {
+  constexpr VkPipelineStageFlags outside_stages =
+      VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+  constexpr VkAccessFlags writes = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+  constexpr VkAccessFlags reads =
+      VK_ACCESS_INDEX_READ_BIT | VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT;
+  if (render_pass_start_ == SIZE_MAX || render_pass_shared_write_ || IsRecordingHoistedSharedUpload() ||
+      !src_stage_mask || (src_stage_mask & ~outside_stages) ||
+      !dst_stage_mask || barriers.empty()) {
+    return false;
+  }
+  for (const auto& barrier : barriers) {
+    if (barrier.buffer != shared_buffer || barrier.pNext || !barrier.size ||
+        !(barrier.srcAccessMask & writes) || (barrier.srcAccessMask & ~(writes | reads)) ||
+        !barrier.dstAccessMask || (barrier.dstAccessMask & ~reads) ||
+        barrier.srcQueueFamilyIndex != VK_QUEUE_FAMILY_IGNORED ||
+        barrier.dstQueueFamilyIndex != VK_QUEUE_FAMILY_IGNORED) {
+      return false;
+    }
+  }
+  // Compute and transfers cannot execute inside this legacy render pass. With
+  // no shared-memory writes in it, their read visibility may precede the pass.
+  const size_t barrier_start = command_stream_.size();
+  CmdVkPipelineBarrier(src_stage_mask, dst_stage_mask, 0, 0, nullptr,
+                       uint32_t(barriers.size()), barriers.data(), 0, nullptr);
+  const size_t barrier_size = command_stream_.size() - barrier_start;
+  std::rotate(command_stream_.begin() + render_pass_start_,
+              command_stream_.begin() + barrier_start, command_stream_.end());
+  render_pass_start_ += barrier_size;
+  return true;
 }
 
