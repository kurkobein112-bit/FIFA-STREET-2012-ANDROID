diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000..08488ba
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,62 @@
+#include <rex/thread/fiber.h>
+#include <cassert>
+#include <cstdlib>
+
+#if !defined(__aarch64__)
+#error Android fibers require ARM64
+#endif
+
+extern "C" void rex_android_swap_context(void* from, const void* to);
+
+namespace rex::thread {
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* fiber = new Fiber();
+  fiber->is_thread_fiber_ = true;
+  tls_current_ = fiber;
+  return fiber;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  if (!entry || stack_size < 16384) return nullptr;
+  auto* fiber = new Fiber();
+  try { fiber->stack_.resize(stack_size); }
+  catch (...) { delete fiber; throw; }
+  fiber->entry_ = entry;
+  fiber->arg_ = arg;
+  static_assert(offsetof(AndroidContext, sp) == 96);
+  static_assert(offsetof(AndroidContext, fpcr) == 104);
+  static_assert(offsetof(AndroidContext, v8_v15) == 128);
+  static_assert(sizeof(AndroidContext) == 256);
+  fiber->context_.sp = reinterpret_cast<uintptr_t>(fiber->stack_.data() + stack_size) & ~uintptr_t(15);
+  fiber->context_.x19_x30[11] = reinterpret_cast<uintptr_t>(&Fiber::Trampoline);
+  asm volatile("mrs %0, fpcr" : "=r"(fiber->context_.fpcr));
+  asm volatile("mrs %0, fpsr" : "=r"(fiber->context_.fpsr));
+  return fiber;
+}
+
+void Fiber::Trampoline() {
+  Fiber* fiber = tls_current_;
+  fiber->entry_(fiber->arg_);
+  // A guest fiber has no caller on its new stack. Returning is an invalid lifecycle.
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  assert(tls_current_ && target);
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_android_swap_context(&from->context_, &target->context_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    assert(tls_current_ == this);
+    tls_current_ = nullptr;
+  } else {
+    assert(tls_current_ != this);
+  }
+  delete this;
+}
+}  // namespace rex::thread
diff --git a/src/core/fiber_android_arm64.S b/src/core/fiber_android_arm64.S
new file mode 100644
index 0000000..152a686
--- /dev/null
+++ b/src/core/fiber_android_arm64.S
@@ -0,0 +1,42 @@
+// AAPCS64 nonvolatile state, with the full v8-v15 registers retained.
+.text
+.p2align 2
+.global rex_android_swap_context
+.hidden rex_android_swap_context
+.type rex_android_swap_context, %function
+rex_android_swap_context:
+    stp x19, x20, [x0, #0]
+    stp x21, x22, [x0, #16]
+    stp x23, x24, [x0, #32]
+    stp x25, x26, [x0, #48]
+    stp x27, x28, [x0, #64]
+    stp x29, x30, [x0, #80]
+    mov x2, sp
+    str x2, [x0, #96]
+    mrs x2, fpcr
+    str x2, [x0, #104]
+    mrs x2, fpsr
+    str x2, [x0, #112]
+    stp q8, q9, [x0, #128]
+    stp q10, q11, [x0, #160]
+    stp q12, q13, [x0, #192]
+    stp q14, q15, [x0, #224]
+    ldp x19, x20, [x1, #0]
+    ldp x21, x22, [x1, #16]
+    ldp x23, x24, [x1, #32]
+    ldp x25, x26, [x1, #48]
+    ldp x27, x28, [x1, #64]
+    ldp x29, x30, [x1, #80]
+    ldr x2, [x1, #96]
+    mov sp, x2
+    ldr x2, [x1, #104]
+    msr fpcr, x2
+    ldr x2, [x1, #112]
+    msr fpsr, x2
+    ldp q8, q9, [x1, #128]
+    ldp q10, q11, [x1, #160]
+    ldp q12, q13, [x1, #192]
+    ldp q14, q15, [x1, #224]
+    ret
+.size rex_android_swap_context, .-rex_android_swap_context
+.section .note.GNU-stack,"",%progbits
