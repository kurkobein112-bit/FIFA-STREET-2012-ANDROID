diff --git a/src/filesystem/content_android.cpp b/src/filesystem/content_android.cpp
new file mode 100644
index 0000000..1a2d441
--- /dev/null
+++ b/src/filesystem/content_android.cpp
@@ -0,0 +1,56 @@
+#include <rex/filesystem.h>
+#include <SDL3/SDL_system.h>
+#include <jni.h>
+#include <cerrno>
+#include <cstring>
+#include <string>
+
+namespace rex::filesystem {
+int OpenAndroidContentFileDescriptor(std::string_view uri, const char* mode) {
+  if (!uri.starts_with("content://") || !mode ||
+      (std::strcmp(mode, "r") && std::strcmp(mode, "w") && std::strcmp(mode, "rw"))) {
+    errno = EINVAL;
+    return -1;
+  }
+  auto* env = static_cast<JNIEnv*>(SDL_GetAndroidJNIEnv());
+  if (!env) { errno = ENODEV; return -1; }
+  if (env->PushLocalFrame(16) < 0) { env->ExceptionClear(); errno = ENOMEM; return -1; }
+  int descriptor = -1;
+  do {
+    jobject activity = static_cast<jobject>(SDL_GetAndroidActivity());
+    if (!activity) break;
+    jclass context_class = env->GetObjectClass(activity);
+    if (!context_class) break;
+    jmethodID get_resolver = env->GetMethodID(context_class, "getContentResolver", "()Landroid/content/ContentResolver;");
+    if (!get_resolver) break;
+    jobject resolver = env->CallObjectMethod(activity, get_resolver);
+    if (env->ExceptionCheck() || !resolver) break;
+    jclass uri_class = env->FindClass("android/net/Uri");
+    if (!uri_class) break;
+    jmethodID parse = env->GetStaticMethodID(uri_class, "parse", "(Ljava/lang/String;)Landroid/net/Uri;");
+    if (!parse) break;
+    jstring uri_string = env->NewStringUTF(std::string(uri).c_str());
+    if (!uri_string) break;
+    jobject parsed_uri = env->CallStaticObjectMethod(uri_class, parse, uri_string);
+    if (env->ExceptionCheck() || !parsed_uri) break;
+    jclass resolver_class = env->GetObjectClass(resolver);
+    if (!resolver_class) break;
+    jmethodID open = env->GetMethodID(resolver_class, "openFileDescriptor", "(Landroid/net/Uri;Ljava/lang/String;)Landroid/os/ParcelFileDescriptor;");
+    if (!open) break;
+    jstring java_mode = env->NewStringUTF(mode);
+    if (!java_mode) break;
+    jobject parcel = env->CallObjectMethod(resolver, open, parsed_uri, java_mode);
+    if (env->ExceptionCheck() || !parcel) break;
+    jclass parcel_class = env->GetObjectClass(parcel);
+    if (!parcel_class) break;
+    jmethodID detach = env->GetMethodID(parcel_class, "detachFd", "()I");
+    if (!detach) break;
+    descriptor = env->CallIntMethod(parcel, detach);
+    if (env->ExceptionCheck()) descriptor = -1;
+  } while (false);
+  if (env->ExceptionCheck()) env->ExceptionClear();
+  env->PopLocalFrame(nullptr);
+  if (descriptor < 0) errno = EIO;
+  return descriptor;
+}
+}  // namespace rex::filesystem
