diff --git a/src/ui/windowed_app_main_android.cpp b/src/ui/windowed_app_main_android.cpp
new file mode 100644
index 0000000..1f86503
--- /dev/null
+++ b/src/ui/windowed_app_main_android.cpp
@@ -0,0 +1,40 @@
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/memory/utils.h>
+#include <rex/thread.h>
+#include <rex/ui/windowed_app.h>
+#include <rex/ui/windowed_app_context_sdl.h>
+#include <algorithm>
+#include <cstdlib>
+#include <exception>
+#include <map>
+#include <string>
+
+extern "C" __attribute__((visibility("default"))) int SDL_main(int argc, char** argv) {
+  auto remaining = rex::cvar::Init(argc, argv);
+  rex::cvar::ApplyEnvironment();
+  rex::InitLoggingEarly();
+  rex::memory::AndroidInitialize();
+  rex::thread::AndroidInitialize();
+  int result = EXIT_FAILURE;
+  try {
+    rex::ui::SDLWindowedAppContext context;
+    auto creator = rex::ui::WindowedApp::GetCreator(REX_ANDROID_APP_ID);
+    if (creator && context.Initialize()) {
+      auto app = creator(context);
+      const auto& names = app->GetPositionalOptions();
+      std::map<std::string, std::string> parsed;
+      for (size_t i = 0; i < std::min(remaining.size(), names.size()); ++i) parsed[names[i]] = remaining[i];
+      app->SetParsedArguments(std::move(parsed));
+      result = app->OnInitialize() ? context.RunMainMessageLoop() : EXIT_FAILURE;
+      app->InvokeOnDestroy();
+    } else {
+      REXLOG_ERROR("Android application or SDL surface initialization failed");
+    }
+  } catch (const std::exception& error) {
+    REXLOG_ERROR("Android application failed: {}", error.what());
+  }
+  rex::thread::AndroidShutdown();
+  rex::memory::AndroidShutdown();
+  return result;
+}
