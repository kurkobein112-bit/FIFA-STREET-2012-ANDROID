diff --git a/include/rex/graphics/vulkan/upload_page_cache.h b/include/rex/graphics/vulkan/upload_page_cache.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/upload_page_cache.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+namespace rex::graphics::vulkan {
+
+// Bounded, exact snapshots of CPU uploads. Collisions evict, never alias pages.
+class UploadPageCache {
+ public:
+  explicit UploadPageCache(size_t page_size, size_t budget = 16 * 1024 * 1024)
+      : page_size_(page_size), slots_(std::max(size_t(1), budget / page_size)) {}
+
+  bool Matches(uint32_t page, const void* bytes) const {
+    const auto& slot = slots_[page % slots_.size()];
+    return slot.valid && slot.page == page &&
+           std::memcmp(slot.bytes.get(), bytes, page_size_) == 0;
+  }
+
+  void Store(uint32_t page, const void* bytes) {
+    auto& slot = slots_[page % slots_.size()];
+    if (!slot.bytes) slot.bytes = std::make_unique<uint8_t[]>(page_size_);
+    std::memcpy(slot.bytes.get(), bytes, page_size_);
+    slot.page = page;
+    slot.valid = true;
+  }
+
+  void Invalidate(uint32_t first, uint32_t count) {
+    if (count >= slots_.size()) {
+      for (auto& slot : slots_) {
+        if (slot.valid && slot.page >= first && uint64_t(slot.page) - first < count)
+          slot.valid = false;
+      }
+    } else {
+      for (uint64_t page = first; page < uint64_t(first) + count; ++page) {
+        auto& slot = slots_[page % slots_.size()];
+        if (slot.valid && slot.page == page) slot.valid = false;
+      }
+    }
+  }
+
+ private:
+  struct Slot {
+    std::unique_ptr<uint8_t[]> bytes;
+    uint32_t page = 0;
+    bool valid = false;
+  };
+  size_t page_size_;
+  std::vector<Slot> slots_;
+};
+
+}  // namespace rex::graphics::vulkan
