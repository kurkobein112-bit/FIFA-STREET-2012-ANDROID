--- /dev/null
+++ b/include/rex/graphics/vulkan/dirty_render_area.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::graphics::vulkan {
+
+// Union every draw scissor and clear rectangle before choosing a pass area.
+class DirtyRenderArea {
+ public:
+  void Include(const VkRect2D& rect) {
+    if (!rect.extent.width || !rect.extent.height) return;
+    const int64_t right = int64_t(rect.offset.x) + rect.extent.width;
+    const int64_t bottom = int64_t(rect.offset.y) + rect.extent.height;
+    if (!has_rect_) {
+      left_ = rect.offset.x; top_ = rect.offset.y; right_ = right; bottom_ = bottom;
+      has_rect_ = true;
+    } else {
+      left_ = std::min(left_, int64_t(rect.offset.x));
+      top_ = std::min(top_, int64_t(rect.offset.y));
+      right_ = std::max(right_, right);
+      bottom_ = std::max(bottom_, bottom);
+    }
+  }
+
+  VkRect2D Clamp(const VkRect2D& original) const {
+    if (!has_rect_) return original;
+    const int64_t left = std::max(left_, int64_t(original.offset.x));
+    const int64_t top = std::max(top_, int64_t(original.offset.y));
+    const int64_t right = std::min(right_, int64_t(original.offset.x) + original.extent.width);
+    const int64_t bottom = std::min(bottom_, int64_t(original.offset.y) + original.extent.height);
+    if (right <= left || bottom <= top) return original;
+    return {{int32_t(left), int32_t(top)}, {uint32_t(right - left), uint32_t(bottom - top)}};
+  }
+
+ private:
+  bool has_rect_ = false;
+  int64_t left_ = 0, top_ = 0, right_ = 0, bottom_ = 0;
+};
+
+}  // namespace rex::graphics::vulkan
