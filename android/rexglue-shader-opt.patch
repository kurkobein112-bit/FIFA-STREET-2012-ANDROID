+#if defined(REX_VULKAN_SPIRV_OPTIMIZER)
+  std::vector<uint32_t> optimized;
+  if (REXCVAR_GET(vulkan_optimize_spirv)) {
+    const auto& properties = vulkan_device->properties();
+    const spv_target_env environment =
+        properties.apiVersion >= VK_API_VERSION_1_3 ? SPV_ENV_VULKAN_1_3 :
+        properties.apiVersion >= VK_API_VERSION_1_2 ? SPV_ENV_VULKAN_1_2 :
+        properties.apiVersion >= VK_API_VERSION_1_1 ?
+            (vulkan_device->extensions().ext_1_2_KHR_spirv_1_4 ?
+                 SPV_ENV_VULKAN_1_1_SPIRV_1_4 : SPV_ENV_VULKAN_1_1) : SPV_ENV_VULKAN_1_0;
+    spvtools::Optimizer optimizer(environment);
+    optimizer.SetMessageConsumer(
+        [](spv_message_level_t, const char*, const spv_position_t&, const char* message) {
+          REXGPU_WARN("SPIR-V optimizer: {}", message);
+        });
+    optimizer.RegisterPerformancePasses(true);
+    spvtools::ValidatorOptions validation_options;
+    validation_options.SetUniformBufferStandardLayout(properties.uniformBufferStandardLayout);
+    validation_options.SetScalarBlockLayout(properties.scalarBlockLayout);
+    spvtools::OptimizerOptions options;
+    options.set_validator_options(validation_options);
+    options.set_preserve_bindings(true);
+    options.set_preserve_spec_constants(true);
+    spvtools::SpirvTools validator(environment);
+    validator.SetMessageConsumer(optimizer.consumer());
+    if (optimizer.Run(shader_module_create_info.pCode, shader_module_create_info.codeSize / sizeof(uint32_t),
+                      &optimized, options) &&
+        validator.Validate(optimized.data(), optimized.size(), validation_options)) {
+      REXGPU_INFO("SPIR-V optimized {:016X}: {} -> {} bytes", shader().ucode_data_hash(),
+                  shader_module_create_info.codeSize, optimized.size() * sizeof(uint32_t));
+      shader_module_create_info.codeSize = optimized.size() * sizeof(uint32_t);
+      shader_module_create_info.pCode = optimized.data();
+    } else {
+      REXGPU_WARN("SPIR-V optimization failed for {:016X}; using original shader", shader().ucode_data_hash());
+    }
+  }
+#endif
   if (vulkan_device->functions().vkCreateShaderModule(vulkan_device->device(),
