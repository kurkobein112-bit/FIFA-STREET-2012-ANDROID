diff --git a/include/rex/thread/android_placement.h b/include/rex/thread/android_placement.h
new file mode 100644
--- /dev/null
+++ b/include/rex/thread/android_placement.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <array>
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <string_view>
+
+namespace rex::thread {
+
+struct AndroidCpuClusters { uint64_t fast = 0, slow = 0; };
+
+inline AndroidCpuClusters SelectAndroidCpuClusters(
+    const std::array<uint64_t, 64>& ceilings, uint64_t allowed) {
+  uint64_t lowest = std::numeric_limits<uint64_t>::max(), highest = 0;
+  for (unsigned cpu = 0; cpu < 64; ++cpu) {
+    if (!(allowed & (uint64_t(1) << cpu))) continue;
+    if (!ceilings[cpu]) return {};
+    lowest = std::min(lowest, ceilings[cpu]);
+    highest = std::max(highest, ceilings[cpu]);
+  }
+  if (!highest || highest == lowest) return {};
+  AndroidCpuClusters result;
+  for (unsigned cpu = 0; cpu < 64; ++cpu) {
+    const uint64_t bit = uint64_t(1) << cpu;
+    if (!(allowed & bit)) continue;
+    (ceilings[cpu] == lowest ? result.slow : result.fast) |= bit;
+  }
+  return result;
+}
+
+// Mode 1 protects the two guest frame producers; mode 2 also places GPU/audio
+// and background workers, following Skate's division by thread name.
+inline int AndroidThreadPlacementRole(std::string_view name, int mode) {
+  if (!mode) return 0;
+  if (name.starts_with("Main XThread") || name.starts_with("RenderThread (")) return 1;
+  if (mode < 2) return 0;
+  for (auto prefix : {"GPU Commands", "Kernel Dispatch", "Audio Worker", "RwAudioCore"})
+    if (name.starts_with(prefix)) return 1;
+  for (auto prefix : {"XMA Decoder", "rwfilesys", "load_thread", "presence_thread"})
+    if (name.starts_with(prefix)) return -1;
+  return 0;
+}
+}  // namespace rex::thread
