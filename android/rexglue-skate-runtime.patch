+static void ResetAndroidInheritedPlacement() {
+  if (!REXCVAR_GET(android_thread_placement)) return;
+  cpu_set_t original, inherited;
+  CPU_ZERO(&original);
+  CPU_ZERO(&inherited);
+  if (sched_getaffinity(getpid(), sizeof(original), &original) != 0 ||
+      sched_getaffinity(0, sizeof(inherited), &inherited) != 0) return;
+  if (CPU_EQUAL(&original, &inherited)) return;
+  // A pinned guest parent must not accidentally pin all of its job workers.
+  // Do this before publishing thread startup, so a parent's explicit set_name
+  // or set_affinity_mask after WaitStarted still takes precedence.
+  if (sched_setaffinity(0, sizeof(original), &original) != 0)
+    REXSYS_WARN("Android inherited placement reset rejected: tid={} errno={}", gettid(), errno);
+}
+
+static void ApplyAndroidThreadPlacement(pthread_t thread, std::string_view name) {
+  const int mode = REXCVAR_GET(android_thread_placement);
+  const int role = AndroidThreadPlacementRole(name, mode);
+  if (!role) return;
+  static const auto ceilings = [] {
+    std::array<uint64_t, 64> values{};
+    for (unsigned cpu = 0; cpu < values.size(); ++cpu) {
+      std::ifstream file("/sys/devices/system/cpu/cpu" + std::to_string(cpu) +
+                         "/cpufreq/cpuinfo_max_freq");
+      file >> values[cpu];
+    }
+    return values;
+  }();
+  const pid_t tid = pthread_gettid_np(thread);
+  cpu_set_t available;
+  CPU_ZERO(&available);
+  if (sched_getaffinity(getpid(), sizeof(available), &available) != 0) {
+    REXSYS_WARN("Android placement unavailable: name={} tid={} errno={}", name, tid, errno);
+    return;
+  }
+  uint64_t allowed = 0;
+  for (unsigned cpu = 0; cpu < 64; ++cpu)
+    if (CPU_ISSET(cpu, &available)) allowed |= uint64_t(1) << cpu;
+  const auto clusters = SelectAndroidCpuClusters(ceilings, allowed);
+  const uint64_t mask = role > 0 ? clusters.fast : clusters.slow;
+  if (!mask) {
+    REXSYS_INFO("Android placement unchanged: name={} tid={} allowed={:X}", name, tid, allowed);
+    return;
+  }
+  cpu_set_t requested;
+  CPU_ZERO(&requested);
+  for (unsigned cpu = 0; cpu < 64; ++cpu)
+    if (mask & (uint64_t(1) << cpu)) CPU_SET(cpu, &requested);
+  if (sched_setaffinity(tid, sizeof(requested), &requested) != 0) {
+    REXSYS_WARN("Android placement rejected: name={} tid={} mask={:X} errno={}", name, tid, mask, errno);
+    return;
+  }
+  if (role < 0) {
+    errno = 0;
+    const int priority = getpriority(PRIO_PROCESS, tid);
+    if (!errno && priority < 5 && setpriority(PRIO_PROCESS, tid, 5) != 0)
+      REXSYS_WARN("Android background nice rejected: name={} tid={} errno={}", name, tid, errno);
+  }
+  REXSYS_INFO("Android placement applied: mode={} name={} tid={} mask={:X}", mode, name, tid, mask);
+}
